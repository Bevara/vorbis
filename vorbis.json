{
    "name": "vorbis",
    "version": "1.0.1",
    "description": "vorbis decoder",
    "filters":["oggdmx","vorbisdec"],
    "help": "This filter decodes Ogg and Vorbis streams through libogg and libvorbis library.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/vorbis.accessor",
    "filter_source":{
        "oggdmx" : "dmx_ogg.c",
        "vorbisdec" : "dec_vorbis.c"
    },
    "Format": ["Vorbis"],
    "extension":{
      "ogg" : "audio"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "royalty-free",
        "note": "Vorbis",
        "checked": "2026-10-16"
    }
}
